{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
NOTE TO DEVELOPERS: welcome to Impact theme! We hope that you will enjoy editing this theme as much as we did for
  developing it. We have put a lot of work to make this theme as developer friendly as possible by offering you
  hooks to integrate into critical parts of the theme. You will find the complete technical documentation (including
  all events, dependencies...) in the "documentation.txt" file, located in the Assets folder.
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<!doctype html>

<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta property="og:image" content="{{ settings.og_image | img_url: '1200x630' }}">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="{{ settings.header_background }}">

    <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% endif %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
    <script type="module" src="{{ 'sections.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
  </head>

  <body class="{% if settings.show_page_transition %}page-transition{% endif %} {% if settings.zoom_image_on_hover %}zoom-image--enabled{% endif %}">
    {%- render 'shadow-dom-templates' -%}

    <a href="#main" class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}

      {%- if settings.cart_type == 'popover' -%}
        <cart-notification-drawer open-from="bottom" class="quick-buy-drawer drawer"></cart-notification-drawer>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' -%}
      {%- section 'account-banner' -%}
    {%- endif -%}

    <main role="main" id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
      IMPLEMENTATION NOTE: due to the very complex logic of margin/padding collapsing in Impact, the footer group is
      added into the main element to ensure that dynamic sections added into the footer group are properly laid out.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- sections 'footer-group' -%}
      {%- endif -%}
    </main>
 <!-- VELOA Sticky CTA -->
<div id="veloa-sticky-cta" style="
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  padding: 12px 16px;
  background: #FAF7F2;
  border-top: 1px solid #E8D9BC;
  box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
">
  <div style="font-family: 'DM Sans', sans-serif;">
    <div style="font-size: 11px; color: #888; line-height: 1.2;">VELOA Pro™</div>
    <div style="font-size: 18px; font-weight: 600; color: #1A1713;">34,90€</div>
  </div>
  <a href="https://veloabrand.com/products/veloa-pro-lime-electrique-pieds-doux-soin-domicile?variant=default" style="
    background: #B76E79;
    color: white;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 4px;
    flex: 1;
    text-align: center;
    text-transform: uppercase;
  ">Acheter maintenant</a>
</div>

<script>
  (function() {
    var bar = document.getElementById('veloa-sticky-cta');
    var lastScroll = 0;
    window.addEventListener('scroll', function() {
      var currentScroll = window.pageYOffset;
      if (currentScroll < 300) {
        bar.style.display = 'none';
      } else {
        bar.style.display = 'flex';
      }
      lastScroll = currentScroll;
    });
    bar.style.display = 'none';
  })();
</script>
<!-- VELOA Social Proof Popup -->
<div id="veloa-popup" style="
  display: none;
  position: fixed;
  bottom: 80px;
  left: 16px;
  z-index: 9998;
  background: #FAF7F2;
  border: 1px solid #E8D9BC;
  border-radius: 8px;
  padding: 12px 16px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.10);
  max-width: 260px;
  font-family: 'DM Sans', sans-serif;
  animation: veloa-slidein 0.4s ease;
">
  <div style="display:flex; align-items:center; gap:10px;">
    <div style="
      width: 36px; height: 36px;
      background: #E8C7BE;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
    ">🛍️</div>
    <div>
      <div id="veloa-popup-name" style="font-size:13px; font-weight:600; color:#1A1713;"></div>
      <div style="font-size:12px; color:#888; margin-top:2px;">vient d'acheter <span style="color:#B76E79; font-weight:600;">VELOA Pro™</span></div>
      <div id="veloa-popup-time" style="font-size:11px; color:#B0A898; margin-top:2px;"></div>
    </div>
  </div>
</div>

<style>
@keyframes veloa-slidein {
  from { opacity: 0; transform: translateX(-20px); }
  to   { opacity: 1; transform: translateX(0); }
}
</style>

<script>
(function() {
  var clients = [
    { name: "Sophie M.", ville: "Paris" },
    { name: "Camille R.", ville: "Lyon" },
    { name: "Inès B.", ville: "Marseille" },
    { name: "Léa T.", ville: "Bordeaux" },
    { name: "Nadia K.", ville: "Bruxelles" },
    { name: "Aurélie D.", ville: "Nantes" },
    { name: "Marine L.", ville: "Toulouse" },
    { name: "Clara V.", ville: "Strasbourg" },
    { name: "Emma P.", ville: "Nice" },
    { name: "Julie F.", ville: "Genève" }
  ];

  var temps = [
    "il y a 2 minutes",
    "il y a 5 minutes",
    "il y a 8 minutes",
    "il y a 12 minutes",
    "il y a 18 minutes",
    "il y a 24 minutes",
    "il y a 1 heure"
  ];

  var popup = document.getElementById('veloa-popup');
  var nameEl = document.getElementById('veloa-popup-name');
  var timeEl = document.getElementById('veloa-popup-time');

  function showPopup() {
    var client = clients[Math.floor(Math.random() * clients.length)];
    var t = temps[Math.floor(Math.random() * temps.length)];
    nameEl.textContent = client.name + " — " + client.ville;
    timeEl.textContent = t;
    popup.style.display = 'block';
    setTimeout(function() {
      popup.style.display = 'none';
    }, 4000);
  }

  // Première apparition après 8 secondes
  setTimeout(function() {
    showPopup();
    // Ensuite toutes les 30 secondes
    setInterval(showPopup, 30000);
  }, 8000);
})();
</script>
 </body>
</html>