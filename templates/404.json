        "liquid": "{% comment %}\n  Lumi-Trek – Grid vidéos autoplay\n  3 vidéos côte à côte même sur mobile\n  Compatible MP4 (Shopify Files)\n{% endcomment %}\n\n{% assign columns = 3 %}\n\n{% assign video_urls = \"\nhttps://cdn.shopify.com/videos/c/o/v/3383b6f4ef7544ccb453e2157de4bd8b.mp4,\nhttps://cdn.shopify.com/videos/c/o/v/4f52735e9b39458a8f863a80b9536a87.mp4,\nhttps://cdn.shopify.com/videos/c/o/v/a94f5604d5584465a5f92c82319ff120.mp4\n\" | strip | split: \",\" %}\n\n<style>\n  .lt-videos {\n    display: grid;\n    grid-template-columns: repeat({{ columns }}, minmax(0, 1fr));\n    gap: 12px;\n    margin: 24px 0;\n  }\n\n  .lt-video {\n    position: relative;\n    width: 100%;\n    border-radius: 14px;\n    overflow: hidden;\n    background: #000;\n  }\n\n  /* Format vertical 9:16 (TikTok / Reels) */\n  .lt-video::before {\n    content: \"\";\n    display: block;\n    padding-top: 177.78%;\n  }\n\n  .lt-video video {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  /* Mobile tweaks (TOUJOURS 3 COLONNES) */\n  @media (max-width: 768px) {\n    .lt-videos {\n      gap: 8px;\n    }\n\n    .lt-video {\n      border-radius: 10px;\n    }\n  }\n</style>\n\n<div class=\"lt-videos\">\n  {% for url in video_urls %}\n    {% assign u = url | strip %}\n    {% if u == blank %}{% continue %}{% endif %}\n\n    <div class=\"lt-video\">\n      <video\n        src=\"{{ u }}\"\n        autoplay\n        muted\n        loop\n        playsinline\n        preload=\"metadata\">\n      </video>\n    </div>\n  {% endfor %}\n</div>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
