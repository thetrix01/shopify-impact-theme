        "tab_Cjm4bF": {
          "type": "tab",
          "settings": {
            "title": "Les Ingrédients",
            "content": "<p><strong>Ingrédient<br/>Eau </strong>Base du produit, donne une texture fluide<br/><strong>Glycérine </strong>Hydrate la peau en profondeur<br/><strong>Dioxyde de titane </strong>Pigment couvrant + protection solaire naturelle<br/><strong>Oxydes de fer (CI 77491/92/99) </strong>Colorent et s’adaptent au teint<br/><strong>Acide hyaluronique </strong>Repulpe la peau, lisse les rides<br/><strong>Vitamine E </strong>Antioxydant, protège la peau<br/><strong>Huile d'arbre à thé </strong>Antibactérien naturel, bon pour l’acné<br/><strong>Huile de menthe poivrée </strong>Effet frais, parfumant<br/><strong>Sodium Lauryl Sulfate (SLS) </strong>Nettoyant/émulsifiant (peut être irritant)<br/><strong>Parfums naturels (citral, etc.) </strong>Donnent une bonne odeur<br/><br/><br/><br/><br/><br/><br/></p><p><br/><br/></p><p><br/></p>",
            "page": ""
          }
        },
        "tab_hyR8CG": {
          "type": "tab",
          "settings": {
            "title": "Mode d’utilisation & résultats",
            "content": "<p><strong>1 Nettoie et hydrate</strong> ton visage.<br/>2 <strong>Secoue</strong> le flacon (si liquide).<br/>3 <strong>Applique une petite quantité</strong> sur les zones clés (front, joues, nez, menton).<br/>4 <strong>Étale</strong> avec les doigts, une éponge ou un pinceau.<br/>5 <strong>Estompe vers l’extérieur</strong> pour un fini naturel.<br/>6 <strong>Ajoute une 2ᵉ couche</strong> si besoin (cernes, imperfections).<br/><br/></p><p><br/><br/></p><p><br/><br/></p><p><br/><br/></p><p><br/></p>",
            "page": ""
          }
        },
        "tab_WxGjiG": {
