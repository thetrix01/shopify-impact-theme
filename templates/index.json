    "images_with_text_scrolling_iJt4m7": {
      "type": "images-with-text-scrolling",
      "blocks": {
        "item_7LhEWk": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/49935511-curcuma-poudre-dans-une-en-bois-cuillere-gratuit-photo.jpg",
            "icon": "none",
            "icon_width": 48,
            "title": "Curcuma",
            "content": "<p><strong>Anti-taches</strong> : inhibe la production de mélanine, ce qui aide à atténuer les taches brunes et l’hyperpigmentation.<br/><strong>Anti-inflammatoire</strong> : calme les irritations, rougeurs et imperfections.<br/><strong>Antioxydant</strong> : protège la peau des radicaux libres et du vieillissement prématuré.<br/><strong>Éclat du teint</strong> : ravive les teints ternes et unifie la peau.<br/><br/><br/><br/><br/></p>"
          }
        },
        "item_DAMhFQ": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/wmremove-transformed.webp",
            "icon": "none",
            "icon_width": 48,
            "title": "Acide Kojique",
            "content": "<p><strong>Éclaircissant puissant</strong> : freine la tyrosinase, enzyme responsable de la production de mélanine.<br/><strong>Réduction des taches pigmentaires</strong> : efficace contre les taches d’acné, taches de soleil, taches de vieillesse.<br/><strong>Unification du teint</strong> : adoucit et homogénéise les différences de couleur de la peau.<br/><strong>Effet doux</strong> : alternative plus naturelle aux agents dépigmentants agressifs comme l’hydroquinone.<br/><br/><br/></p>"
          }
        },
        "item_br4UeK": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/42351.webp",
            "icon": "none",
            "icon_width": 48,
            "title": "Vitamine C",
            "content": "<p><strong>Antioxydant majeur</strong> : neutralise les radicaux libres.<br/><strong>Boost de collagène</strong> : améliore l’élasticité de la peau.<br/><strong>Anti-taches</strong> : freine l’oxydation de la mélanine et réduit les taches brunes.<br/><strong>Éclat instantané</strong> : rend la peau plus lumineuse et plus saine.<br/><br/><br/><br/></p>"
          }
        },
        "item_X4wyiC": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/wmremove-transformed.jpg",
            "icon": "none",
            "icon_width": 48,
            "title": "Alpha Arbutine",
            "content": "<p>Aide à reduire les taches brunes, à freiner la production de mélanine et à unifier le teint sans irriter la peau. Parfait pour les peaux sensibles sujettes à l'hyperpigmentation.</p>"
          }
        },
        "item_3GeKBL": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/5701CITRON_FEUILLES_NON_TRAITES.webp",
            "icon": "none",
            "icon_width": 48,
            "title": "Citron",
            "content": "<p>Naturellement riche en Vitamine C et en acides de fruits, le citron aide à éclaircir le teint, réduire les taches et resserrer les pores. Il purifiela peau en douceur et lui apporte un effet frais et lumineux.</p>"
          }
        }
      },
