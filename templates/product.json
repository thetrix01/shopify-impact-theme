ss=\"veloa-bundle__info\">\n          <span class=\"veloa-bundle__pack-name\">Pack 3</span>\n          <span class=\"veloa-bundle__qty\">3 VELOA</span>\n        </span>\n        <span class=\"veloa-bundle__prices\">\n          <span class=\"veloa-bundle__price\">79,90 €</span>\n          <span class=\"veloa-bundle__compare\">209,70 €</span>\n        </span>\n        <span class=\"veloa-bundle__save\">Économisez 129,80 €</span>\n      </span>\n    </label>\n\n  </div>\n</div>\n\n<style>\n  .veloa-bundle{--r:#f5e1dc;--rd:#e8c4ba;--b:#faf5ef;--g:#c9a86a;--gd:#b08d4f;--t:#3a2a26;--m:#8a7570;margin:24px 0;color:var(--t);font-family:inherit}\n  .veloa-bundle__title{font-size:.95rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin:0 0 14px;text-align:center}\n  .veloa-bundle__options{display:flex;flex-direction:column;gap:12px}\n  .veloa-bundle__option{position:relative;display:block;cursor:pointer;border-radius:14px}\n  .veloa-bundle__radio{position:absolute;opacity:0;pointer-events:none}\n  .veloa-bundle__card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;padding:16px 18px;border:2px solid var(--r);background:var(--b);border-radius:14px;transition:.2s}\n  .veloa-bundle__option:hover .veloa-bundle__card{border-color:var(--rd)}\n  .veloa-bundle__dot{width:20px;height:20px;border-radius:50%;border:2px solid var(--rd);background:#fff;transition:.2s}\n  .veloa-bundle__radio:checked ~ .veloa-bundle__card .veloa-bundle__dot{border-color:var(--g);background:radial-gradient(circle,var(--g) 45%,#fff 50%)}\n  .veloa-bundle__radio:checked ~ .veloa-bundle__card{border-color:var(--g);background:#fff;box-shadow:0 6px 22px rgba(201,168,106,.18)}\n  .veloa-bundle__info{display:flex;flex-direction:column;gap:2px}\n  .veloa-bundle__pack-name{font-size:1rem;font-weight:700}\n  .veloa-bundle__qty{font-size:.82rem;color:var(--m);font-weight:500}\n  .veloa-bundle__prices{display:flex;flex-direction:column;align-items:flex-end;line-height:1.15}\n  .veloa-bundle__price{font-size:1.08rem;font-weight:700}\n  .veloa-bundle__compare{font-size:.8rem;color:var(--m);text-decoration:line-through}\n  .veloa-bundle__save{grid-column:1/-1;margin-top:10px;padding-top:10px;border-top:1px dashed var(--rd);font-size:.82rem;font-weight:600;color:var(--gd);text-align:center}\n  .veloa-bundle__badge{position:absolute;top:-10px;right:16px;background:var(--rd);color:#fff;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:999px;z-index:2;box-shadow:0 2px 8px rgba(232,196,186,.5)}\n  .veloa-bundle__badge--gold{background:linear-gradient(135deg,var(--g),var(--gd));box-shadow:0 2px 10px rgba(176,141,79,.35)}\n  @media (max-width:540px){\n    .veloa-bundle__card{padding:14px;gap:10px}\n    .veloa-bundle__pack-name{font-size:.92rem}\n    .veloa-bundle__qty{font-size:.76rem}\n    .veloa-bundle__price{font-size:1rem}\n    .veloa-bundle__compare{font-size:.74rem}\n    .veloa-bundle__badge{font-size:.62rem;padding:4px 10px}\n    .veloa-bundle__dot{width:18px;height:18px}\n  }\n</style>\n\n<script>\n(function(){\n  var b=document.querySelector('[data-veloa-bundle]');if(!b)return;\n  function forms(){return document.querySelectorAll('form[action*=\"/cart/add\"]');}\n  function setQ(q){forms().forEach(function(f){\n    var i=f.querySelector('input[name=\"quantity\"]');\n    if(i){i.value=q;i.dispatchEvent(new Event('input',{bubbles:true}));i.dispatchEvent(new Event('change',{bubbles:true}));}\n    else{var h=f.querySelector('input[data-veloa-qty]');if(!h){h=document.createElement('input');h.type='hidden';h.name='quantity';h.setAttribute('data-veloa-qty','');f.appendChild(h);}h.value=q;}\n  });}\n  function curQ(){var c=b.querySelector('.veloa-bundle__radio:checked');if(!c)return 1;return parseInt(c.closest('.veloa-bundle__option').getAttribute('data-quantity'),10)||1;}\n  b.addEventListener('change',function(e){if(e.target.classList.contains('veloa-bundle__radio'))setQ(curQ());});\n  var init=function(){setQ(curQ());};\n  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();\n  window.addEventListener('load',init);\n  document.addEventListener('submit',function(e){var f=e.target;if(f&&f.action&&f.action.indexOf('/cart/add')!==-1){var i=f.querySelector('input[name=\"quantity\"]');if(i)i.value=curQ();}},true);\n})();\n</script>"
